# Fates of Nations — copier vers .env.local et remplir (ne jamais committer .env.local)
# Projet Supabase de référence : ssnqervwthlqvbewhtrd
# Dashboard → Settings → API Keys
# L'accès CLI se configure avec `supabase login`, jamais avec un jeton dans ce fichier.

NEXT_PUBLIC_SUPABASE_URL=https://ssnqervwthlqvbewhtrd.supabase.co
# Clé publique moderne : sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement, jamais exposée au navigateur : sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# Routes /api/cron/* — même valeur en prod sur Vercel et dans les appels planifiés
CRON_SECRET=

# Optionnel : dispatch Discord (admin bot)
DISCORD_BOT_TOKEN=

# Worker RP Magnum (secrets serveur/Edge uniquement)
INFERMATIC_API_KEY=
INFERMATIC_API_URL=https://api.totalgpt.ai/v1/chat/completions
RP_PIPELINE_EDGE_SECRET=
RP_PIPELINE_EDGE_ENABLED=false

# Les webhooks sont ajoutés comme secrets Edge sous un nom stable,
# puis ce nom (jamais l'URL) est enregistré dans le routage Supabase.
# Exemple : DISCORD_WEBHOOK_DEFAULT=
